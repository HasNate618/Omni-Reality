{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["frame_id", "count", "objects"],
  "properties": {
    "frame_id": { "$ref": "#/$defs/ulid" },
    "count": { "type": "integer", "minimum": 0 },
    "objects": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "u0", "v0", "u1", "v1", "score"],
        "properties": {
          "object_id": { "$ref": "#/$defs/ulid" },
          "u0": { "$ref": "#/$defs/unit_pixel" },
          "v0": { "$ref": "#/$defs/unit_pixel" },
          "u1": { "$ref": "#/$defs/unit_pixel" },
          "v1": { "$ref": "#/$defs/unit_pixel" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "error": { "enum": ["no_object", "timeout", "busy", "invalid"] }
  },
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-7][0-9a-hjkmnp-tv-z]{25}$", "minLength": 26, "maxLength": 26 },
    "unit_pixel": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
